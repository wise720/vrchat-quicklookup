# VRChat API User-Agent contact (email or https URL). Required.
VRCHAT_CONTACT=

# Optional full User-Agent override:
# VRCHAT_USER_AGENT=VRChatQuickLookup/0.2.0 you@yourdomain.com

# Neon Postgres connection string (free tier: https://neon.tech)
DATABASE_URL=

# Optional: comma-separated admin VRChat user ids (also seed via pnpm seed:admin)
# ADMIN_VRCHAT_USER_IDS=usr_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ADMIN_VRCHAT_USER_IDS=
