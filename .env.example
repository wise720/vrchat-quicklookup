# Contact VRChat can reach you at (email or https URL). Required.
# Example: VRCHAT_CONTACT=moderation@yourdomain.com
VRCHAT_CONTACT=

# Optional full override. Must include app name, version, and contact, e.g.:
# VRCHAT_USER_AGENT=VRChatQuickLookup/0.1.0 moderation@yourdomain.com
# VRCHAT_USER_AGENT=

# Optional: directory for session cookie + filters.json (default: ./data)
# DATA_DIR=/absolute/or/relative/path/to/data
