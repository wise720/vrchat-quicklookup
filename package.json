{
  "name": "vrchat-quicklookup",
  "private": true,
  "version": "0.3.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "predev": "pnpm --filter @vrchat-quicklookup/shared build",
    "dev": "pnpm -r --parallel --filter @vrchat-quicklookup/api --filter @vrchat-quicklookup/web run dev",
    "dev:api": "pnpm --filter @vrchat-quicklookup/shared build && pnpm --filter @vrchat-quicklookup/api dev",
    "dev:web": "pnpm --filter @vrchat-quicklookup/shared build && pnpm --filter @vrchat-quicklookup/web dev",
    "build": "pnpm --filter @vrchat-quicklookup/shared build && pnpm --filter @vrchat-quicklookup/api build && pnpm --filter @vrchat-quicklookup/web build",
    "seed:owner": "pnpm --filter @vrchat-quicklookup/shared build && pnpm --filter @vrchat-quicklookup/api seed:owner"
  }
}
